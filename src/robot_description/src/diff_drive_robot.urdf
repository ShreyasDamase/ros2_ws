<?xml version="1.0"?>
<robot name="diff_drive_robot">
  <!-- ===== Materials ===== -->
  <material name="red">
    <color rgba="0.9 0.1 0.1 1" />
  </material>
  <material name="yellow">
    <color rgba="0.95 0.85 0.1 1" />
  </material>
  <material name="blue">
    <color rgba="0.1 0.1 0.8 1" />
  </material>

  <!-- ===== Chassis: box 0.4 x 0.2 x 0.1 m, 2 kg =====
       ixx = m/12*(y^2+z^2) = 2/12*(0.04+0.01) = 0.00833
       iyy = m/12*(x^2+z^2) = 2/12*(0.16+0.01) = 0.02833
       izz = m/12*(x^2+y^2) = 2/12*(0.16+0.04) = 0.03333 -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.2 0.1" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.2 0.1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0" />
      <inertia ixx="0.00833" ixy="0" ixz="0" iyy="0.02833" iyz="0" izz="0.03333" />
    </inertial>
  </link>

  <!-- ===== Wheels: cylinder r=0.05, width=0.04, 0.2 kg =====
       Cylinder axis is its local Z, which is the spin axis.
       ixx = iyy = m/12*(3r^2+h^2) = 0.000152
       izz = 1/2*m*r^2           = 0.00025 -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04" />
      </geometry>
      <material name="yellow" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.000152" ixy="0" ixz="0" iyy="0.000152" iyz="0" izz="0.00025" />
    </inertial>
  </link>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04" />
      </geometry>
      <material name="yellow" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.000152" ixy="0" ixz="0" iyy="0.000152" iyz="0" izz="0.00025" />
    </inertial>
  </link>

  <!-- ===== Caster: sphere r=0.03, 0.1 kg =====
       I = 2/5*m*r^2 = 0.000036 on all axes -->
  <link name="caster">
    <visual>
      <geometry>
        <sphere radius="0.03" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.03" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.000036" ixy="0" ixz="0" iyy="0.000036" iyz="0" izz="0.000036" />
    </inertial>
  </link>


  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 0.12 -0.03" rpy="-1.5708 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 -0.12 -0.03" rpy="-1.5708 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="caster" />
    <origin xyz="0.15 0 -0.055" rpy="0 0 0" />
  </joint>


  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher" />
  </gazebo>
</robot>